# Copy to .env.server. Never use VITE_ for secrets.
# The default runs entirely offline. Set AI_PROVIDER=gemini to enable optional AI.
AI_PROVIDER=offline
AI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
# For OpenRouter: AI_PROVIDER=openrouter, AI_MODEL=<your model ID>, AI_API_KEY=<key>
AI_API_KEY=
# Optional compatible provider only (HTTPS required)
AI_BASE_URL=
PORT=8787
# Development UI. For the built app served by this backend, use http://127.0.0.1:8787
APP_ORIGIN=http://127.0.0.1:5173
