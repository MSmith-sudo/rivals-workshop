{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Rivals Workshop private profile library version 2",
 "type":"object",
 "required":["schema","version","migrated","profiles"],
 "properties":{
  "schema":{"const":"rivals-workshop.library"},"version":{"const":2},"migrated":{"type":"boolean"},
  "profiles":{"type":"array","maxItems":50,"items":{"$ref":"#/$defs/profile"}}
 },
 "$defs":{
  "chapters":{"type":"array","minItems":6,"maxItems":6,"items":{"type":["string","null"],"maxLength":300000}},
  "profile":{"type":"object","required":["id","name","created","updated","consent","original","chapters"],"properties":{
   "id":{"type":"string","minLength":1,"maxLength":100},"name":{"type":"string","minLength":1,"maxLength":80},
   "created":{"type":"string","format":"date-time"},"updated":{"type":"string","format":"date-time"},
   "consent":{"type":"object","required":["team"],"properties":{"team":{"type":"boolean"}}},
   "original":{"$ref":"#/$defs/chapters"},"chapters":{"$ref":"#/$defs/chapters"}
  }}
 }
}
